rules_version = '2';

// ============================================================
// Vida Financeira — regras de segurança do Firestore
// ------------------------------------------------------------
// Estas regras são a única coisa que protege a base de dados. O
// código do site é público: qualquer pessoa o pode ler e chamar o
// Firebase directamente. Por isso não basta verificar no JavaScript
// — tem de estar aqui.
//
// Princípio: cada pessoa só chega aos seus próprios movimentos.
// Não há administrador: ninguém vê o dinheiro de outra pessoa.
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function ehDono(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // ----------------------------------------------------------
    // utilizadores/{uid} — os movimentos de cada pessoa
    // O documento tem o mesmo id da conta, por isso o dono é sempre
    // quem lá está. Sem sessão iniciada não se lê nem se escreve nada.
    // ----------------------------------------------------------
    match /utilizadores/{uid} {
      allow read, write: if ehDono(uid);

      // Espaço para o futuro (metas, contas separadas, etc.): o que
      // estiver debaixo do documento da pessoa pertence à mesma pessoa.
      match /{sub=**} {
        allow read, write: if ehDono(uid);
      }
    }

    // ----------------------------------------------------------
    // vendas/{id} — as chaves de assinatura emitidas
    //
    // Só o administrador lê e escreve. Não guarda nada sobre quem usa
    // a aplicação: os movimentos das pessoas continuam onde sempre
    // estiveram, no dispositivo delas e na sua própria área privada.
    //
    // Esta lista de emails é a que manda, porque corre do lado do
    // servidor. A lista igual no firebase-config.js serve apenas para a
    // página saber o que mostrar — mudá-la no navegador não dá acesso a
    // dado nenhum.
    // ----------------------------------------------------------
    function ehAdmin() {
      return request.auth != null
          && request.auth.token.email in ['wly.vianna@gmail.com'];
    }

    match /vendas/{id} {
      allow read, create, update, delete: if ehAdmin();
    }

    // ----------------------------------------------------------
    // Tudo o resto fica fechado. Se um dia acrescentarmos uma
    // colecção nova, ela não funciona até se escrever a regra —
    // e isso é de propósito.
    // ----------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
